  (text "AZERO = AA | BB | CC1 & ACCLR | CC2 & ACCLR | CC3 & G2CLA | DD | EE | FF\nASEL_0 (PCTR,MADR) = HH | JJ | LL\nASEL_1 (efad,MADR) = HH | JJ | MM\nBZERO = AA | CC3 & ~G2OSR | HH | JJ | KK | LL | MM | NN\nBSEL_0 (INBUS) = BB | CC\nBSEL_1 (DMADR) = DD\nCIN = FF | JJ | NN & MBUF_0\nQSEL_0 (AND) = PP1\nQSEL_1 (ADD) = FF | JJ | NN | PP2"
    (at 871.22 635 0)
    (effects (font (size 2.032 2.032)) (justify left bottom))
    (uuid c13e9c27-afe2-449c-98d4-d84deb181696)
  )
  (text "TS4: MADR <= efaddr" (at 756.92 741.68 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid c17038ac-5727-4eb5-b5e6-012671c12ee0)
  )
  (text "end-of-instruction\n indicates current cycle is last of instruction\n  or last of break or interrupt acknowledge\nendinst =\n  FETCH : JMP: direct JMP\n          IOT: always\n          OPR: non-mem-ref ext arith\n  DEFER : JMP\n  EXEC  : always\n  BREAK : always\n  INTAK : always"
    (at 755.65 264.16 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid c31aca91-f023-4084-b5c3-2a6f5ba3bfee)
