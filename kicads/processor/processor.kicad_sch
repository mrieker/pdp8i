  (text "Field Select\n 0 : instruction\n 1 : data\n 2 : zero\n 3 : break"
    (at 541.02 312.42 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e2349f51-f5cb-4d11-8c6e-52119842ddaa)
  )
  (text "TS4: MADR <= PCTR" (at 756.92 711.2 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e3878c31-3635-4775-8d34-0e9cdf8872fc)
  )
  (text "AA: ? <= 0            : A=ZERO, B=ZERO,  OR\nBB: ? <= INBUS        : A=ZERO, B=INBUS, OR\nCC: ? <= ACUM | INBUS : A=ACUM, B=INBUS, OR\nDD: ? <= DMADR        : A=ZERO, B=DMADR, OR\nEE: ? <= MBUF         : A=ZERO, B=MBUF,  OR\nFF: ? <= MBUF + 1     : A=ZERO, B=MBUF,  ADD, CIN=1\nHH: ? <= MADR         : A=MADR, B=ZERO,  OR\nJJ: ? <= MADR + 1     : A=MADR, B=ZERO,  ADD, CIN=1\nKK: ? <= ACUM         : A=ACUM, B=ZERO,  OR\nLL: ? <= PCTR         : A=PCTR, B=ZERO,  OR\nMM: ? <= efaddr       : A=efad, B=ZERO,  OR\nNN: ? <= ACUM + IAC   : A=ACUM, B=ZERO,  ADD, CIN=MBUF_0\nPP: ? <= ACUM & MBUF  : A=ACUM, B=MBUF,  AND\nPP: ? <= ACUM + MBUF  : A=ACUM, B=MBUF,  ADD, CIN=0"
    (at 871.22 601.98 0)
    (effects (font (face "Courier 10 Pitch") (size 2.032 2.032)) (justify left bottom))
    (uuid e3d57218-95d5-4343-91b5-f304c5502041)
  )
  (text "MAJOR STATE\n 0 : PWRON\n 1 : FETCH\n 2 : DEFER\n 3 : EXEC\n 4 : WRDCT\n 5 : CURAD\n 6 : BREAK\n 7 : INTAK\n 8 : DEPOS\n 9 : EXAM"
    (at 896.62 213.36 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e9068f8c-05f2-4eb9-bdfc-2a92fb1d1bb7)
  )
