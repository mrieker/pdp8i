  )
  (text "either switch jams in state 000x\n swSTART at any time\n swCONT when in DEPOS or EXAM\nnote: swCONT when not DEPOS or EXAM\n leaves state as is"
    (at 815.34 114.3 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid af2cd25e-466b-4986-bbb7-f25979e6c6f0)
  )
  (text "new state for switches:\n LDAD: EXAM\n EXAM: EXAM\n DEPOS: DEPOS\n START: FETCH\n CONT: if currently EXAM or DEPOS, FETCH\n       otherwise, leave state as is"
    (at 825.5 195.58 0)
