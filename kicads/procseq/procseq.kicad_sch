  (text "end-of-instruction\n indicates current cycle is last of instruction\n  or last of break or interrupt acknowledge\nendinst =\n  FETCH : JMP: direct JMP\n          IOT: always\n          OPR: non-mem-ref ext arith\n  DEFER : JMP\n  EXEC  : always\n  BREAK : always\n  INTAK : always"
    (at 755.65 264.16 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid c31aca91-f023-4084-b5c3-2a6f5ba3bfee)
  )
