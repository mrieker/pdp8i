    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 239204e0-45f5-4d21-972c-9f81b3e12ad6)
  )
  (text "INBUS\n-----\n  TS1:\n    data from memory\n  TS2 & BREAK & BRKWRM:\n    dma data from i/o dev\n  IOP:\n    pio data from i/o device"
    (at 13.97 306.07 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 2e9b4922-7f71-44de-b723-ef0af6f8e9c6)
  )
  (text "divide step is a shift left when quotient bit is zero"
    (at 48.26 485.14 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 4b2f8532-a6ef-4b76-ab7b-b207d2198e93)
  )
  (text "LINK bit for left shifts:\n* loaded at TP2 from processor LINK\n* clocked by s3clk pulses during shifts"
    (at 114.3 596.9 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 4ba591fc-1a50-4f29-bf35-c37befd6aa1f)
  )
  (text "memory operand follows opcode\nretained in MBUF by processor\nthroughout EXEC cycle"
    (at 668.02 477.52 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 62ad9427-495a-4fc3-ac1d-47f492622246)
