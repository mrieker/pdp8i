  (text "TS4: MADR <= PCTR" (at 553.72 223.52 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e3878c31-3635-4775-8d34-0e9cdf8872fc)
  )
  (text "AA: ? <= 0            : A=ZERO, B=ZERO,  OR\nBB: ? <= INBUS        : A=ZERO, B=INBUS, OR\nCC: ? <= ACUM | INBUS : A=ACUM, B=INBUS, OR\nEE: ? <= MBUF         : A=ZERO, B=MBUF,  OR\nFF: ? <= MBUF + 1     : A=ZERO, B=MBUF,  ADD, CIN=1\nHH: ? <= MADR         : A=MADR, B=ZERO,  OR\nJJ: ? <= MADR + 1     : A=MADR, B=ZERO,  ADD, CIN=1\nKK: ? <= ACUM         : A=ACUM, B=ZERO,  OR\nLL: ? <= PCTR         : A=PCTR, B=ZERO,  OR\nMM: ? <= efaddr       : A=efad, B=ZERO,  OR\nNN: ? <= ACUM + IAC   : A=ACUM, B=ZERO,  ADD, CIN=MBUF_0\nPP: ? <= ACUM & MBUF  : A=ACUM, B=MBUF,  AND\nPP: ? <= ACUM + MBUF  : A=ACUM, B=MBUF,  ADD, CIN=0"
    (at 664.21 93.98 0)
    (effects (font (face "Courier 10 Pitch") (size 2.032 2.032)) (justify left bottom))
    (uuid e3d57218-95d5-4343-91b5-f304c5502041)
  )
  (text "complement ACUM value\n* must have Group1 instr\n* must have CMA bit\n* must be doing FETCH cycle"
