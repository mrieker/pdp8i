    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 270b2dc8-468b-4193-b3f4-9c0ff14ba031)
  )
  (text "divide step is a shift left when quotient bit is zero"
    (at 144.78 480.06 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 4b2f8532-a6ef-4b76-ab7b-b207d2198e93)
  )
  (text "LINK bit for left shifts:\n* loaded at TP2 from processor LINK\n* clocked by s3clk pulses during shifts"
    (at 210.82 591.82 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 4ba591fc-1a50-4f29-bf35-c37befd6aa1f)
  )
  (text "acsel  condition\n  0    TS1 & msfetch                                    - get initial ACUM contents into MYAC\n  1    TS2 & extarex                                    - get step 2 results into ACUM\n  2    TS3 & (extop31 == 2 & muymbit)                   - MUY step with multiplier bit set\n  3    TS3 & (extop31 == 3 & dviqbit)                   - DVI step with quotient bit set\n  4    TS3 & (extop31 == 4)                             - NMI step\n  5    TS3 & (extop31 == 5 | extop31 == 3 & ~ dviqbit)  - shift left for SHL or DVI step with quotient bit clear\n  6    TS3 & (extop31 == 6)                             - shift right for ASR\n  7    TS3 & (extop31 == 7 | extop31 == 2 & ~ muymbit)  - shift right for LSR or MUY step with multiplier bit clear"
    (at 226.06 462.28 0)
    (effects (font (face "Courier 10 Pitch") (size 2.54 2.54)) (justify left bottom))
    (uuid 79edc24f-6864-45ce-9efc-ab75a1b6cdf3)
  )
  (text "load 0 at TP2 for NMI\nload 20 at TP2 for MUY,DVI\nload ~YREG at TP2 for SCL,SHL,ASR,LSR"
    (at 589.28 137.16 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 7d9601ed-6d63-47a4-a531-883221d28a88)
  )
  (text "enable incrementing during TS3 (step 3)" (at 675.64 162.56 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 92301a26-8a4d-4457-9ae5-552a038121b6)
  )
  (text "memory operand follows opcode\nretained in MBUF by processor\nthroughout EXEC cycle"
    (at 632.46 210.82 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 9636781d-eeeb-4d24-9fc6-a8d0635e2fc4)
  )
  (text "TP2 & extarex:\n  load step2 result" (at 119.38 529.59 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ca0e72e9-c63e-4be9-87f3-e51381d6166f)
  )
  (text "s3clk:\n  shift/arith step" (at 119.38 537.21 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid cb997347-552e-48ae-be33-1b144a3d0679)
  )
  (text "TP1 & FETCH:\n  load ACUM or zero" (at 119.38 514.35 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e521b583-a006-487d-a0d0-b8af6feeaf68)
  )
  (text "extop<3:1>\n  0 : NOP : new link = old link\n  1 : SCL : new link = old link\n  2 : MUY : new link = 0\n  3 : DVI : new link = overflow\n  4 : NMI : new link = last bit shifted out\n  5 : SHL : new link = last bit shifted out\n  6 : ASR : new link = sign bit\n  7 : LSR : new link = 0"
    (at 519.43 530.86 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid eea13b5d-e0c8-46b2-ad4a-4aa6b9417cac)
  )
  (text "clear SCTR on bus init" (at 675.64 182.88 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid f8930f47-0e14-4ea2-9be2-36d375b47ca2)
  )
  (text "enable loading during TS2 for extarex\n cycles and extop<3:1> ne 000"
