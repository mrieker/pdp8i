  (text "FLDSEL  USE\n   0      data field  - EXEC & AND/TAD/ISZ/DCA & prev DEFER\n   1      inst field   - everything else\n   2      break field - BREAK\n   3      zero field  - INTAK | WRDCT | CURAD"
    (at 737.87 276.86 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid c4702a26-e8ce-4133-8fe0-422e1cff0e4e)
  )
  (text "save ifld and dfld when about\n to do an interrupt acknowledge"
    (at 501.65 48.26 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ce062a59-fe70-4784-af96-7cdefe7e71af)
