

	KSF   = 06031	/ skip if kb char to be read
	KCC   = 06032	/ clear kb flag, clear acc, start reader
	KRS   = 06034	/ read kb char but don't clear flag
	KIE   = 06035	/ keyboard and printer interrupt enable
	KRB   = 06036	/ read kb char and clear flag

	TFL   = 06040	/ set tt flag pretending it is ready to accept
	TSF   = 06041	/ skip if tt ready to accept
	TCF   = 06042	/ clear tt flag
	TPC   = 06044	/ start printing tt char
	TLS   = 06046	/ clear tt flag, start printing tt char

	SWP   = 07521	/ swap MQ,AC

*0010
AI10,	0

_0012,	0012
_0015,	0015
_0060,	0060
_0076,	0076
_0177,	0177
_7720,	7720
_7770,	7770
_7772,	7772
_7774,	7774

_IOCT36, IOCT36
_MUL36,  MUL36
_POCT54, POCT54
_POCTAL, POCTAL
_PRCHAR, PRCHAR
_PRCRLF, PRCRLF
_RDCHAR, RDCHAR

AC1,	0	/ one number to multiply
AC2,	0
AC3,	0
OP1,	0	/ other number to multiply
OP2,	0
OP3,	0
MUL0,	0	/ resultant product
MUL1,	0
MUL2,	0
MUL3,	0
MUL4,	0
MUL5,	0
MUL6,	0

*0200

	.global	__boot
__boot,
	CLA
	KIE
	TAD	_0177
	TLS
START,
	CLA			/ prompt for number entry
	TAD	_0076		/ >
	JMS	PRCHAR
	JMS I	_IOCT36		/ read in first number
		0052		/ *
		AC1
	JMS I	_IOCT36		/ read in second number
		0075		/ =
		OP1
	JMS I	_MUL36		/ multiply
	JMS I	_POCT54		/ print product
		MUL1
	JMS	PRCRLF
	JMP	START		/ try again

/ print CRLF
PRCRLF,	0
	TAD	_0015
	JMS	PRCHAR
	TAD	_0012
	JMS	PRCHAR
	JMP I	PRCRLF

/ print char in AC then clear AC
PRCHAR,	0
	TSF
	JMP	.-1
	TLS
	CLA
	JMP I	PRCHAR

/ read char from keyboard into AC (no echo)
RDCHAR,	0
	KSF
	JMP	.-1
	KRB
	AND	_0177
	JMP I	RDCHAR


*0400

/ input a 36-bit number in octal up to the terminator char
/ echo the digits and the terminator
/	JMS	IOCT36
/		termchar
/		3wordbuff
IOCT36,	0
	TAD I	IOCT36		/ get term char
	ISZ	IOCT36
	CMA IAC			/ ...negative
	DCA	IO36NT
	DCA	IO36D1		/ clear temp output
	DCA	IO36D2
	DCA	IO36D3
IO36RD,
	CLA
	JMS I	_RDCHAR		/ read keyboard char
	DCA	IO36CH
	TAD	IO36CH		/ check for terminator
	TAD	IO36NT
	SNA CLA
	JMP	IO36EX		/ if so, we're done
	TAD	IO36CH		/ check for octal digit
	TAD	_7720
	SPA
	JMP	IO36RD		/ if not, ignore
	DCA	IO36CH
	TAD	IO36CH
	TAD	_7770
	SMA CLA
	JMP	IO36RD

	TAD	IO36CH		/ ok, echo char
	TAD	_0060
	JMS I	_PRCHAR

	TAD	IO36D3		/ shift into bottom of IO36D1,2,3
	MQL
	TAD	IO36CH
	MUY
		0010
				/ AC,MQ = D3 shifted
	SWP
				/ MQ,AC = D3 shifted
	DCA	IO36D3
				/ MQ,AC = top D3 shifted, zero
	TAD	IO36D2
				/ MQ,AC = top D3 shifted, D2 unshifted
	SWP
				/ AC,MQ = top D3 shifted, D2 unshifted
	MUY
		0010
				/ AC,MQ = D2 shifted
	SWP
	DCA	IO36D2
	TAD	IO36D1
	SWP
	MUY
		0010
	SWP
	DCA	IO36D1
	JMP	IO36RD

IO36EX,
	TAD	IO36CH		/ echo terminator
	JMS I	_PRCHAR
	CLA CMA			/ get output pointer
	TAD I	IOCT36
	ISZ	IOCT36
	DCA	AI10
	TAD	IO36D1		/ copy out result
	DCA I	AI10
	TAD	IO36D2
	DCA I	AI10
	TAD	IO36D3
	DCA I	AI10
	JMP I	IOCT36		/ return

IO36CH,	0
IO36D1,	0
IO36D2,	0
IO36D3,	0
IO36NT,	0

*0600

/ print a 54-bit octal number
/	JMS	POCT54
/		6wordbuff
POCT54,	0
	TAD I	POCT54		/ get buff pointer
	ISZ	POCT54
	DCA	PO54BP
	TAD	_7772		/ print 6 words
	DCA	PO54CT
PO54LP,
	TAD I	PO54BP
	ISZ	PO54BP
	JMS	POCTAL
	ISZ	PO54CT
	JMP	PO54LP
	JMP I	POCT54

PO54BP,	0
PO54CT,	0

POCTAL,	0
	MQL
	TAD	_7774
	DCA	POCTCT
POCTLP,
	SHL
		0002
	TAD	_0060
	JMS I	_PRCHAR
	ISZ	POCTCT
	JMP	POCTLP
	JMP I	POCTAL

POCTCT,	0

*2000

	/        AC1,2,3  7777 7777 7777
	/     x  OP1,2,3  7777 7777 7777
	/ --------------
	/                     [AC3.OP3]                          7776  0001
	/                                                        mul5
	/                [AC2.OP3]                         7776  0001
	/                                                  mul4  mul5
	/                [AC3.OP2]                         7776  0001
	/                                            mul3  mul4
	/           [AC1.OP3]                        7776  0001
	/           [AC3.OP1]                        7776  0001
	/           [AC2.OP2]                        7776  0001
	/      [AC1.OP2]                       7776  0001
	/      [AC2.OP1]                       7776  0001
	/ [AC1.OP1]                      7776  0001
	/ -----------------------------  ----  ----  ----  ----  ----  ----
	/ MUL1 MUL2 MUL3 MUL4 MUL5 MUL6  7777 27777 47774 47773 27774  0001
	/ -----------------------------  ----  ----  ----  ----  ----  ----
	/                                0000  0077  7777  7760  0000  0001
	/                                      [    result    ]

MULTBL,	AC3		/ MUL4,5,6 += AC3 * OP3
	OP3
	MUL6
	AC2		/ MUL3,4,5 += AC2 * OP3
	OP3
	MUL5
	AC3		/ MUL3,4,5 += AC3 * OP2
	OP2
	MUL5
	AC1		/ MUL2,3,4 += AC1 * OP3
	OP3
	MUL4
	AC3		/ MUL2,3,4 += AC3 * OP1
	OP1
	MUL4
	AC2		/ MUL2,3,4 += AC2 * OP2
	OP2
	MUL4
	AC1		/ MUL1,2,3 += AC1 * OP2
	OP2
	MUL3
	AC2		/ MUL1,2,3 += AC2 * OP1
	OP1
	MUL3
	AC1		/ MUL0,1,2 += AC1 * OP1
	OP1
	MUL2
	0		/ end of MULTBL

_MULTBLm1, MULTBL-1

/ multiply two 36-bit numbers
/ return 72-bit product
/  input:
/   AC1,2,3 = one operand
/   OP1,2,3 = other operand
/   AC = 0
/  output:
/   MUL1,2,3,4,5,6 = product
/   MUL0 = scratch (should still be zero)
/   AI10 = scratch
/   AC = 0

MUL36,	0 

	DCA	MUL1
	DCA	MUL2
	DCA	MUL3
	DCA	MUL4
	DCA	MUL5
	DCA	MUL6

	TAD	_MULTBLm1
	DCA	AI10

MULOOP,

	TAD I	AI10		/ point to ACi
	SNA
	JMP I	MUL36		/ end of MULTBL, done
	DCA	MULTMP
	TAD I	MULTMP		/ get ACn value
	DCA	MULYYY		/ ...into YREG

	TAD I	AI10		/ point to OPj
	DCA	MULTMP
	TAD I	MULTMP		/ get OPj value
	MQL			/ ...into MQ

	TAD I	AI10		/ point to MUL(i+j)
	DCA	MULTMP
	CMA
	TAD	MULTMP		/ point to MUL(i+j-1)
	DCA	MULTMPm1
	CMA
	TAD	MULTMPm1	/ point to MUL(i+j-2)
	DCA	MULTMPm2
	TAD I	MULTMP		/ get previous product in MUL(i+j)
	MUY
MULYYY,	0
	TAD I	MULTMPm1	/ save most significant word in MUL(i+j-1)
	DCA I	MULTMPm1
	RAL			/ maybe it carries out to MUL(i+j-2)
	TAD I	MULTMPm2
	DCA I	MULTMPm2
	SZL			/ should not have a carry out of that
	HLT
	MQA			/ save least signicant word in MUL(i+j)
	DCA I	MULTMP
	JMP	MULOOP		/ process next entry in MULTBL

MULTMP,   0	/ points to MUL(i+j)
MULTMPm1, 0	/ points to MUL(i+j-1)
MULTMPm2, 0	/ points to MUL(i+j-2)

