// test a 36bit x 36bit => 72 bits multiply

	KSF   = 06031	/ skip if kb char to be read
	KCC   = 06032	/ clear kb flag, clear acc, start reader
	KRS   = 06034	/ read kb char but don't clear flag
	KIE   = 06035	/ keyboard and printer interrupt enable
	KRB   = 06036	/ read kb char and clear flag

	TFL   = 06040	/ set tt flag pretending it is ready to accept
	TSF   = 06041	/ skip if tt ready to accept
	TCF   = 06042	/ clear tt flag
	TPC   = 06044	/ start printing tt char
	TLS   = 06046	/ clear tt flag, start printing tt char

	SWP   = 07521	/ swap MQ,AC

*0010
AI10,	0
AI11,	0
AI12,	0
AI13,	0
AI14,	0

_0012,	0012
_0015,	0015
_0060,	0060
_0076,	0076
_0177,	0177
_7720,	7720
_7770,	7770
_7772,	7772
_7774,	7774

_IOCT36, IOCT36
_MUL36,  MUL36
_POCT72, POCT72
_POCTAL, POCTAL
_PRCHAR, PRCHAR
_PRCRLF, PRCRLF
_RDCHAR, RDCHAR

AC1,	0	/ one number to multiply
AC2,	0
AC3,	0
OP1,	0	/ other number to multiply
OP2,	0
OP3,	0
MUL6,	0	/ (lsw) resultant product
MUL5,	0
MUL4,	0
MUL3,	0
MUL2,	0
MUL1,	0
MUL0,	0	/ (msw)

*0200

	.global	__boot
__boot,
	CLA
	KIE
	TAD	_0177
	TLS
START,
	CLA			/ prompt for number entry
	TAD	_0076		/ >
	JMS	PRCHAR
	JMS I	_IOCT36		/ read in first number
		0052		/ *
		AC1
	JMS I	_IOCT36		/ read in second number
		0075		/ =
		OP1
	JMS I	_MUL36		/ multiply
	JMS I	_POCT72		/ print product
		MUL1
	JMS	PRCRLF
	JMP	START		/ try again

/ print CRLF
PRCRLF,	0
	TAD	_0015
	JMS	PRCHAR
	TAD	_0012
	JMS	PRCHAR
	JMP I	PRCRLF

/ print char in AC then clear AC
PRCHAR,	0
	TSF
	JMP	.-1
	TLS
	CLA
	JMP I	PRCHAR

/ read char from keyboard into AC (no echo)
RDCHAR,	0
	KSF
	JMP	.-1
	KRB
	AND	_0177
	JMP I	RDCHAR


*0400

/ input a 36-bit number in octal up to the terminator char
/ echo the digits and the terminator
/	JMS	IOCT36
/		termchar
/		3wordbuff
IOCT36,	0
	TAD I	IOCT36		/ get term char
	ISZ	IOCT36
	CMA IAC			/ ...negative
	DCA	IO36NT
	DCA	IO36D1		/ clear temp output
	DCA	IO36D2
	DCA	IO36D3
IO36RD,
	CLA
	JMS I	_RDCHAR		/ read keyboard char
	DCA	IO36CH
	TAD	IO36CH		/ check for terminator
	TAD	IO36NT
	SNA CLA
	JMP	IO36EX		/ if so, we're done
	TAD	IO36CH		/ check for octal digit
	TAD	_7720
	SPA
	JMP	IO36RD		/ if not, ignore
	DCA	IO36CH
	TAD	IO36CH
	TAD	_7770
	SMA CLA
	JMP	IO36RD

	TAD	IO36CH		/ ok, echo char
	TAD	_0060
	JMS I	_PRCHAR

	TAD	IO36D3		/ shift into bottom of IO36D1,2,3
	MQL
	TAD	IO36CH
	MUY
		0010
				/ AC,MQ = D3 shifted
	SWP
				/ MQ,AC = D3 shifted
	DCA	IO36D3
				/ MQ,AC = top D3 shifted, zero
	TAD	IO36D2
				/ MQ,AC = top D3 shifted, D2 unshifted
	SWP
				/ AC,MQ = top D3 shifted, D2 unshifted
	MUY
		0010
				/ AC,MQ = D2 shifted
	SWP
	DCA	IO36D2
	TAD	IO36D1
	SWP
	MUY
		0010
	SWP
	DCA	IO36D1
	JMP	IO36RD

IO36EX,
	TAD	IO36CH		/ echo terminator
	JMS I	_PRCHAR
	CLA CMA			/ get output pointer
	TAD I	IOCT36
	ISZ	IOCT36
	DCA	AI10
	TAD	IO36D1		/ copy out result
	DCA I	AI10
	TAD	IO36D2
	DCA I	AI10
	TAD	IO36D3
	DCA I	AI10
	JMP I	IOCT36		/ return

IO36CH,	0
IO36D1,	0
IO36D2,	0
IO36D3,	0
IO36NT,	0

*0600

/ print a 72-bit octal number
/	JMS	POCT72
/		6wordbuff
POCT72,	0
	TAD I	POCT72		/ get buff pointer
	ISZ	POCT72
	DCA	PO72BP
	TAD	_7772		/ print 6 words
	DCA	PO72CT
PO72LP,
	TAD I	PO72BP
	JMS	POCTAL
	CMA
	TAD	PO72BP
	DCA	PO72BP
	ISZ	PO72CT
	JMP	PO72LP
	JMP I	POCT72

PO72BP,	0
PO72CT,	0

/ print AC in octal
/  input:
/   AC = number to print
/  output:
/   AC,MQ = zero
POCTAL,	0
	MQL			/ stick number to print in MQ
	TAD	_7774		/ set up num digits to print
	DCA	POCTCT
POCTLP,
	SHL			/ get 3 bits from MQ into AC
		0002
	TAD	_0060		/ convert to ascii
	JMS I	_PRCHAR		/ print
	ISZ	POCTCT		/ go on to next
	JMP	POCTLP
	JMP I	POCTAL		/ done

POCTCT,	0

*2000

	/        AC1,2,3  7777 7777 7777
	/     x  OP1,2,3  7777 7777 7777
	/ ------------------------------
	/                      [AC3.OP3]
	/                 [AC2.OP3]
	/                 [AC3.OP2]
	/            [AC1.OP3]
	/            [AC3.OP1]
	/            [AC2.OP2]
	/       [AC1.OP2]
	/       [AC2.OP1]
	/  [AC1.OP1]
	/ ------------------------------
	/  MUL1 MUL2 MUL3 MUL4 MUL5 MUL6
	/ ------------------------------

/ multiply two 36-bit numbers
/ return 72-bit product
/  input:
/   AC1,2,3 = one operand
/   OP1,2,3 = other operand
/   AC = 0
/  output:
/   MUL1,2,3,4,5,6 = product
/   MUL0 = scratch (should still be zero)
/   AI11,12,13,14 = scratch
/   AC = 0

MUL36,	0 

	DCA	MUL1
	DCA	MUL2
	DCA	MUL3
	DCA	MUL4
	DCA	MUL5
	DCA	MUL6

	TAD	_MUL2m1
	DCA	MULPTR

	CLA CLL CMA RTL		/ reset ACi counter
	DCA	MULCT1		/ ...to -3
	TAD	_AC1m1		/ ...and pointer
	DCA	AI13
MULOP1,
	TAD I	AI13		/ get ACi value
	DCA	MULYYY		/ ...into YREG

	CLA CLL CMA RTL		/ reset OPj counter
	DCA	MULCT2		/ ...to -3
	TAD	_OP1m1		/ ...and pointer
	DCA	AI14

	TAD	MULPTR		/ point just before MUL(i+j)
MULOP2,
				/ AC = addr of MUL(i+j)-1
	DCA	AI11		/ set up two pointers to MUL(i+j)-1
	TAD	AI11
	DCA	AI12

	TAD I	AI14		/ get OPj value
	MQL			/ ...into MQ
	TAD I	AI11		/ get previous product from MUL(i+j)
	MUY			/ multiply Y * MQ + AC => AC,MQ
MULYYY,	0
	SWP			/ save least signicant word in MUL(i+j)
	DCA I	AI12
	SWP
	TAD I	AI11		/ save most significant word in MUL(i+j-1)
	DCA I	AI12
	SZL
MULCAR,
	ISZ I	AI11		/ maybe there is carry to MUL(i+j-2)
	SKP
	JMP	MULCAR
	CLA CLL CMA RTL		/ reset MUL(i+j) pointer
	TAD	AI12
	ISZ	MULCT2		/ maybe more inner loop
	JMP	MULOP2
	CLA CMA
	TAD	MULPTR		/ reset MUL(i) pointer
	DCA	MULPTR
	ISZ	MULCT1		/ maybe more outer loop
	JMP	MULOP1
	TAD	MUL0		/ shouldn't have carries this far
	SZA
	HLT
	JMP I	MUL36

_AC1m1,	 AC1-1
_OP1m1,	 OP1-1
_MUL2m1, MUL2-1

MULPTR,	0
MULCT1,	0
MULCT2,	0

